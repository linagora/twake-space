KAFKA_BOOTSTRAP=localhost:9092
KAFKA_SECURITY=plaintext
KAFKA_GROUP_ID=twake-space
DATABASE_URL=postgres://twake_space:twake_space@localhost:5432/twake_space
HTTP_PORT=8080
LOG_LEVEL=info
LDAP_REST_URL=http://localhost:8081
LDAP_REST_SERVICE_ID=twake-space
LDAP_REST_SECRET=
OIDC_ISSUER=https://sign-up.twake.app/
OIDC_CLIENT_SECRET=
# Errors and logs go to Sentry when set.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging

# Single installation: one homeserver for every organization, set all or none.
# SECRETS_KEY is 32 random bytes in base64 (openssl rand -base64 32).
# MATRIX_HOMESERVER_URL=https://matrix.example.com
# MATRIX_SERVER_NAME=example.com
# MATRIX_AS_TOKEN=
# MATRIX_HS_TOKEN=
# SECRETS_KEY=
# How Synapse's SSO mapping builds Matrix localparts: from the LDAP uid, or the
# local part of the email.
MATRIX_LOCALPART=uid

# KAFKA_SECURITY=ssl (OVH mTLS)
# KAFKA_SSL_CA=/etc/kafka/ca.pem
# KAFKA_SSL_CERT=/etc/kafka/service.cert
# KAFKA_SSL_KEY=/etc/kafka/service.key

# KAFKA_SECURITY=sasl_ssl (SCRAM-SHA-512)
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SSL_CA=
