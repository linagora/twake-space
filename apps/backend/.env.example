KAFKA_BOOTSTRAP=localhost:9092
KAFKA_SECURITY=plaintext
KAFKA_GROUP_ID=twake-space
DATABASE_URL=postgres://twake_space:twake_space@localhost:5432/twake_space
HTTP_PORT=8080
LOG_LEVEL=info
LDAP_REST_URL=http://localhost:8081
LDAP_REST_SERVICE_ID=twake-space
LDAP_REST_SECRET=
OIDC_ISSUER=https://sign-up.twake.app/
OIDC_CLIENT_SECRET=
# Errors and logs go to Sentry when set.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging

