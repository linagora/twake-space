{
  "name": "Space",
  "name_prefix": "Twake",
  "slug": "space",
  "version": "0.1.7",
  "type": "webapp",
  "licence": "AGPL-3.0",
  "icon": "src/assets/space.svg",
  "categories": ["cozy"],
  "source": "https://github.com/linagora/twake-space",
  "editor": "Cozy",
  "developer": {
    "name": "Twake Workplace",
    "url": "https://twake.app"
  },
  "standalone": true,
  "client_url_flag": "space.embedded-app-url",
  "permissions": {
    "banners": {
      "description": "Required by the cozy-bar to display platform messages",
      "type": "io.cozy.banners",
      "verbs": ["GET", "PUT"]
    },
    "apps": {
      "description": "Required by the cozy-bar to display the icons of the apps",
      "type": "io.cozy.apps",
      "verbs": ["GET"]
    },
    "settings": {
      "description": "Required by the cozy-bar to display storage usage",
      "type": "io.cozy.settings",
      "verbs": ["GET"]
    },
    "files": {
      "description": "Required to get shortcuts",
      "type": "io.cozy.files",
      "verbs": ["GET"],
      "selector": "name",
      "values": ["Home"]
    }
  }
}
